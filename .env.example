# Optional Alibaba Cloud Model Studio / DashScope credentials.
# Do not commit real values.
DASHSCOPE_API_KEY=

# Optional region/workspace endpoint override.
# Singapore default:
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
