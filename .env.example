# Optional ElevenLabs Speech to Text credentials.
# Do not commit real values.
ELEVENLABS_API_KEY=

# Optional ElevenLabs STT behavior.
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_STT_LANGUAGE_CODE=en
# ELEVENLABS_STT_TAG_AUDIO_EVENTS=true
# ELEVENLABS_STT_TIMESTAMPS_GRANULARITY=word
# ELEVENLABS_STT_DIARIZE=false
# ELEVENLABS_STT_NO_VERBATIM=false

# Optional Alibaba Cloud Model Studio / DashScope credentials.
# Do not commit real values.
DASHSCOPE_API_KEY=

# Optional region/workspace endpoint override.
# Singapore default:
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Custom Model Studio compatible endpoint:
# DASHSCOPE_BASE_URL=https://your-workspace-host/compatible-mode/v1

# Optional ASR behavior.
# DASHSCOPE_ASR_MODEL=qwen3-asr-flash
# VIDEO_INTEL_ASR_LANGUAGE=en
# VIDEO_INTEL_ASR_ENABLE_ITN=false
